# Author: Oleh Riabtsev
# File: .env.example
# Created: 2026-11-23
# Version: 1.4.0

APP_NAME="Mattermost Document Approval Engine"
APP_PORT=8000
MATTERMOST_PORT=8065

# Internal Docker network endpoints for container-to-container callbacks
PUBLIC_BASE_URL="http://workflow-engine:8000"
MATTERMOST_URL="http://mattermost:8065"

# Browser-accessible URL used in Mattermost DM links to open the Visual Workflow Studio
STUDIO_PUBLIC_URL="http://localhost:8000"

MATTERMOST_BOT_TOKEN="replace_with_generated_bot_token"
MATTERMOST_WEBHOOK_SECRET="local_dev_webhook_secret_2026"

# Enable real-time bot Direct Message listener for 'start' / 'старт' commands
ENABLE_BOT_WS_LISTENER="true"

# PostgreSQL databases used by docker-compose.yml
POSTGRES_USER="workflow_user"
POSTGRES_PASSWORD="workflow_pass"
POSTGRES_DB="workflow_db"
MATTERMOST_DB="mattermost_db"
POSTGRES_PORT=5432

# Local fallback connection string outside Docker
DATABASE_URL="postgresql+asyncpg://workflow_user:workflow_pass@localhost:5432/workflow_db"
AUTO_CREATE_TABLES="false"

WORKFLOWS_CONFIG_PATH="workflows.yaml"
LOCALES_PATH="locales.yaml"
UPLOAD_DIR="uploads"

# Default language for Mattermost cards and API responses when not specified (en | de)
DEFAULT_LANG="en"

# Console and system log output language (en | de | ru)
CONSOLE_LANG="en"

LOG_LEVEL="INFO"
