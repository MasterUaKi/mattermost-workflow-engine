# Author: Oleh Riabtsev
# File: .env.example
# Created: 2026-11-23
# Version: 1.1.0

APP_NAME="Mattermost Document Approval Engine"
PUBLIC_BASE_URL="http://host.docker.internal:8000"
MATTERMOST_URL="http://localhost:8065"
MATTERMOST_BOT_TOKEN="your_mattermost_bot_access_token_here"
MATTERMOST_WEBHOOK_SECRET="change_me_random_secret_token"

# SQLite for MVP; for PostgreSQL use: postgresql+asyncpg://user:pass@localhost:5432/workflow_db
DATABASE_URL="sqlite+aiosqlite:///./workflow_engine.db"

WORKFLOWS_CONFIG_PATH="workflows.yaml"
LOCALES_PATH="locales.yaml"
UPLOAD_DIR="uploads"

# Default language for Mattermost cards and API responses when not specified (en | de)
DEFAULT_LANG="en"

# Console and system log output language (en | de | ru)
CONSOLE_LANG="en"

LOG_LEVEL="INFO"
