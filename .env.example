# Author: Oleh Riabtsev
# File: .env.example
# Created: 2026-11-23
# Version: 1.2.0

APP_NAME="Mattermost Document Approval Engine"
APP_PORT=8000
PUBLIC_BASE_URL="http://host.docker.internal:8000"
MATTERMOST_URL="http://host.docker.internal:8065"
MATTERMOST_BOT_TOKEN="your_mattermost_bot_access_token_here"
MATTERMOST_WEBHOOK_SECRET="change_me_random_secret_token"

# PostgreSQL settings used by docker-compose.yml
POSTGRES_USER="workflow_user"
POSTGRES_PASSWORD="workflow_pass"
POSTGRES_DB="workflow_db"
POSTGRES_PORT=5432

# Used when running outside Docker (e.g., local PyCharm development); Docker Compose overrides this automatically
DATABASE_URL="postgresql+asyncpg://workflow_user:workflow_pass@localhost:5432/workflow_db"

WORKFLOWS_CONFIG_PATH="workflows.yaml"
LOCALES_PATH="locales.yaml"
UPLOAD_DIR="uploads"

# Default language for Mattermost cards and API responses when not specified (en | de)
DEFAULT_LANG="en"

# Console and system log output language (en | de | ru)
CONSOLE_LANG="en"

LOG_LEVEL="INFO"
